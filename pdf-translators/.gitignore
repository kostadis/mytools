__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Marker ML dependency (~5 GB of torch + model weights).
# Setup: python3 -m venv marker-env && source marker-env/bin/activate && pip install marker-pdf
marker-env/

# Editor/converter working state (backups + persistent undo logs).
*.bak
*.undolog.json

# Local secrets — ANTHROPIC_API_KEY etc.
.env

# Per-run batch conversion logs (one .log per module).
ddex3-logs/
batch/dmsguild-logs/

# batch_convert.py working state (state DB, skiplist, manifest, nohup log) —
# regenerated per run, lives next to the batch scripts in batch/.
batch/dmsguild-state.db
batch/dmsguild-state.db.bak-*
batch/dmsguild-skiplist.tsv
batch/dmsguild-manifest.json
batch/dmsguild-batch.out

# Mistral OCR batch resume maps (stem->pdf, regenerated each run).
mistral-ocr-map.json
ocr-three-map.json

# Scratch backups of OCR extract/markdown output.
scratchpad-*-backup/
