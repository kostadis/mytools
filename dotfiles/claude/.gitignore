# Credentials
.credentials.json

# Auto-recall memory — owned by ~/src/claude-memory (github.com/kostadis/claude-memory),
# which syncs it across machines on a cron. Tracking it here too created a second
# authority that drifted; do not re-add.
memory/

# Claude Code's own sync of claude.ai account skills. It writes here whenever
# ~/.claude/skills is linked to claude/skills/, so it lands in this tree — not ours.
skills/synced/

# Runtime / ephemeral data
backups/
cache/
file-history/
history.jsonl
paste-cache/
projects/
sessions/
shell-snapshots/
plans/
